# Copy to .env and fill in. .env is git-ignored; never commit keys.

# ---- Primary LLM provider (used first) ----
PRIMARY_LLM_PROVIDER=groq        # groq / gemini / openrouter / openai (sets the default base URL)
PRIMARY_LLM_API_KEY=             # <-- your key
PRIMARY_LLM_BASE_URL=            # optional, for any other OpenAI-compatible endpoint or gateway
PRIMARY_LLM_MODEL=openai/gpt-oss-120b

# ---- Fallback LLM provider (used only if primary fails) ----
FALLBACK_LLM_PROVIDER=gemini
FALLBACK_LLM_API_KEY=            # <-- your key (optional; the service runs without a fallback)
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=gemini-flash-latest

# ---- LLM call behaviour ----
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=800
LLM_MAX_INPUT_TOKENS=7200        # context budget for evidence + history; keep input + output under the provider's tokens-per-minute limit
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENT_REQUESTS=3

# ---- App ----
POLICY_DIR=                      # path to the policy .md files (default: ./policies in this repo)
INDEX_CACHE_DIR=.cache/policy_index   # relative to api/
RETRIEVAL_CACHE_SIZE=512
CHAT_HISTORY_TURNS=4
ALLOWED_ORIGINS=http://localhost:3000   # comma-separated CORS origins for the web UI
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Karachi        # used to resolve "today" and relative dates

# ---- Deploy (scripts/deploy.mjs only; never copied to Vercel) ----
VERCEL_TOKEN=                    # from https://vercel.com/account/tokens
